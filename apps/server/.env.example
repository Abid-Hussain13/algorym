# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Supabase: Project Settings → Database → Connection string.
#
# Use the SESSION pooler (port 5432) rather than the direct connection when the
# project is IPv6-only, which the free tier often is. Do NOT use the transaction
# pooler (port 6543) here: it hands back connections in transaction mode, which
# is a poor fit for a connection pool that stays open.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Supabase free tier allows few concurrent connections; this caps ours so the
# surplus is refused visibly rather than hanging. Optional.
DB_POOL_MAX=10

# Local development only — used when DATABASE_URL is absent.
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=algorym
# DB_DATABASE=algorym

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Exact origin of the deployed frontend. CORS and auth cookies are both keyed
# off this, so it must match the Netlify URL exactly — no trailing slash.
CLIENT_URL=http://localhost:5173

# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-secret
JWT_REFRESH_SECRET=change-me-to-a-different-random-secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ---------------------------------------------------------------------------
# Third-party services
# ---------------------------------------------------------------------------
# Code execution (RapidAPI sandbox)
CODE_RUN_URL=https://sandboxapi.p.rapidapi.com
CODE_RUN_API_HOST=sandboxapi.p.rapidapi.com
CODE_RUN_API_KEY=your-rapidapi-key

# AI question generation
GEMINI_API_KEY=your-gemini-api-key

# Transactional email (verification, password reset)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Algorym <noreply@yourdomain.com>
VERIFY_TOKEN_EXPIRY_HOURS=24
RESET_TOKEN_EXPIRY_MINUTES=30

# Optional: owner account that `pnpm db:seed` attaches demo data to.
# SEED_MAIN_USER_EMAIL=you@example.com